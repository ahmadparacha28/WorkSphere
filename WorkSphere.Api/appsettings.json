{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=WorkSphereDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "WorkSphere",
    "Audience": "WorkSphereUsers",
    "ExpiryMinutes": 60
  },
  "FileUpload": {
    "ResumeFolder": "App_Data/Resumes",
    "MaxFileSizeMB": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}